# ============================================================================
# LimenOS "deck" kernel config fragment  —  Miyoo Flip (miyoo355 / RK3566)
# ============================================================================
# Merge onto the board's working defconfig with:
#   scripts/kconfig/merge_config.sh -m .config kernel/limen-deck.config
#
# Every option below is EITHER
#   (a) absent from the stock 5.10.160 config and needed, or
#   (b) present as =y and changed to =m so we can swap in a patched build.
# Verified against research/stock-firmware/stock-kernel-5.10.160.config.
# ============================================================================

# ---------------------------------------------------------------------------
# Tunnels & virtual interfaces   [stock: ALL ABSENT — no VPN, no pivots]
# ---------------------------------------------------------------------------
CONFIG_TUN=y
CONFIG_VETH=m
CONFIG_DUMMY=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_STP=m
CONFIG_LLC=m
CONFIG_LLC2=m
CONFIG_VLAN_8021Q=m
CONFIG_VLAN_8021Q_GVRP=y
CONFIG_WIREGUARD=m
CONFIG_PPP=m
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPPOE=m
CONFIG_PPP_ASYNC=m
CONFIG_L2TP=m
CONFIG_L2TP_ETH=m

# ---------------------------------------------------------------------------
# nftables + full netfilter   [stock: iptables-legacy only]
# ---------------------------------------------------------------------------
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_QUEUE=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_NETLINK_QUEUE=m

# ---------------------------------------------------------------------------
# USB Wi-Fi adapters  [stock: NOT ONE of these existed — the core blocker]
# ---------------------------------------------------------------------------
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m                 # AR9271 / AR7010 — the reliable workhorse
CONFIG_ATH9K_HTC_DEBUGFS=y
CONFIG_CARL9170=m
CONFIG_ATH6KL=m

CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7921U=m                   # modern 11ax, good mainline monitor support
CONFIG_MT7663U=m

CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y

CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTW88=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW89=m

CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_USB_ZD1201=m
CONFIG_ZD1211RW=m
CONFIG_WLAN_VENDOR_INTERSIL=y
CONFIG_P54_USB=m
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_USB=y

# The vendor radio: build as a MODULE so a monitor-patched build can replace it
# (stock has CONFIG_RTL8733BU=y — built in, therefore unremovable).
CONFIG_RTL8733BU=m

# ---------------------------------------------------------------------------
# mac80211 extras for capture / rogue-AP work
# ---------------------------------------------------------------------------
CONFIG_MAC80211_MESH=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_CFG80211_WEXT=y             # some legacy userland still wants this

# ---------------------------------------------------------------------------
# USB Ethernet — adapters (host side)  [stock: ALL ABSENT]
# ---------------------------------------------------------------------------
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_RTL8150=m
CONFIG_USB_RTL8152=m

# ---------------------------------------------------------------------------
# USB gadget — the "plug into a laptop and ssh in" link  [stock: NO ECM/RNDIS]
# ---------------------------------------------------------------------------
CONFIG_USB_ETH=m
CONFIG_USB_ETH_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_F_HID=y        # keep HID gadget (stock already had F_HID)
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_F_ECM=m
CONFIG_USB_F_NCM=m
CONFIG_USB_F_RNDIS=m
CONFIG_USB_F_EEM=m
CONFIG_USB_F_SERIAL=m

# ---------------------------------------------------------------------------
# More USB serial / hardware-hacking adapters (stock had the big four)
# ---------------------------------------------------------------------------
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_MCT_U232=m
CONFIG_USB_SERIAL_TI=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL_SIMPLE=m

# ---------------------------------------------------------------------------
# Containers / tracing / observability
# ---------------------------------------------------------------------------
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_CGROUP_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_PACKET_DIAG=m
CONFIG_NETLINK_DIAG=m
CONFIG_INET_DIAG=m
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_NETEM=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m

# ---------------------------------------------------------------------------
# Memory pressure — mandatory at ~1 GB RAM
# ---------------------------------------------------------------------------
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSMALLOC=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# ---------------------------------------------------------------------------
# Filesystems for the capture vault + forensics
# ---------------------------------------------------------------------------
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_FUSE_FS=y
CONFIG_CUSE=m
CONFIG_NBD=m
CONFIG_BLK_DEV_LOOP=y
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_CIFS=m
CONFIG_NFS_FS=m

# ---------------------------------------------------------------------------
# Keep: modules must stay loadable and unsigned (stock already allowed this)
# ---------------------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODULE_FORCE_LOAD=y
# CONFIG_MODULE_SIG is not set

# ---------------------------------------------------------------------------
# Keep: already correct in stock, listed so a merge never regresses them
# ---------------------------------------------------------------------------
CONFIG_PACKET=y
CONFIG_INPUT_UINPUT=y
CONFIG_OVERLAY_FS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP_FILTER=y
CONFIG_USB_F_HID=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_CONFIGFS=y
