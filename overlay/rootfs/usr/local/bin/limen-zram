#!/bin/sh
# limen-zram — compressed swap. NOT optional on a ~1GB device.
#
#   limen-zram on [size_mb]     default 768M of zram (lz4)
#   limen-zram off
#   limen-zram status
set -u
SIZE_MB="${2:-768}"
case "${1:-status}" in
  on)
    modprobe zram 2>/dev/null || true
    [ -e /sys/block/zram0 ] || { echo "no zram device (CONFIG_ZRAM missing?)"; exit 1; }
    swapoff /dev/zram0 2>/dev/null || true
    echo 1 > /sys/block/zram0/reset 2>/dev/null || true
    echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || true
    echo "$((SIZE_MB))M" > /sys/block/zram0/disksize
    mkswap /dev/zram0 >/dev/null
    swapon -p 100 /dev/zram0
    # favour reclaiming into zram over OOM-killing a capture
    sysctl -q vm.swappiness=180 2>/dev/null || sysctl -q vm.swappiness=100
    sysctl -q vm.vfs_cache_pressure=50
    echo "zram on: ${SIZE_MB}M lz4"
    ;;
  off) swapoff /dev/zram0 2>/dev/null; echo 1 > /sys/block/zram0/reset 2>/dev/null; echo "zram off";;
  *)
    free -h 2>/dev/null
    [ -e /sys/block/zram0/disksize ] && {
      echo "zram disksize : $(cat /sys/block/zram0/disksize)"
      echo "zram algorithm: $(cat /sys/block/zram0/comp_algorithm 2>/dev/null)"
    }
    cat /proc/swaps 2>/dev/null
    ;;
esac
